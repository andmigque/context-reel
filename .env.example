# Cadence reads each vendor key from the env var named by its bot row.
# The browser only ever holds the NAME below, never the value.
# Copy this file to .env and fill in the keys you have.

ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# Toggle the mock token stream. While true, the chat streams a synthetic
# answer token-by-token and never calls a vendor. Flip to false once real
# vendor keys above are set and the live backends are wired.
CADENCE_MOCK_STREAM=true
